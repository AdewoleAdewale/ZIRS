<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.ShopListPage"
            BackgroundColor="#064E3B">

    <StackLayout Spacing="0">
        <!-- Top Title Header -->
        <Label Text="SHOP LIST" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,15,0,2"/>
        <Label Text="ZAMFARA INTERNAL REVENUE SERVICE (ZIRS)" TextColor="#D1FAE5" FontSize="10" HorizontalOptions="Center" Margin="0,0,0,15"/>

        <!-- Main Body Sheet -->
        <Frame CornerRadius="14" BackgroundColor="#F9FAFB" Padding="15" HasShadow="False" VerticalOptions="FillAndExpand">
            <StackLayout Spacing="10">

                <!-- Market Name Header -->
                <Frame CornerRadius="10" BackgroundColor="White" Padding="12" HasShadow="False" BorderColor="#E5E7EB">
                    <Label Text="{Binding SelectedMarket.Market_Plaza}" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" TextColor="#064E3B" />
                </Frame>

                <!-- Search Bar -->
                <Frame CornerRadius="12" Padding="6,0" HasShadow="False" BorderColor="#D1D5DB" BackgroundColor="White">
                    <SearchBar x:Name="ShopSearchBar" 
                               Placeholder="Search by shop number_" 
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="Transparent"
                               CancelButtonColor="#064E3B" />
                </Frame>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="{Binding TotalFound, StringFormat='{0} shops found'}" FontSize="11" TextColor="Gray" VerticalOptions="Center"/>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#064E3B" HeightRequest="20" WidthRequest="20"/>
                </Grid>

                <!-- Paginated List (50 at a time) -->
                <CollectionView ItemsSource="{Binding DisplayedShops}" 
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5" CornerRadius="12" BorderColor="#E5E7EB" BackgroundColor="White" HasShadow="False" Padding="14">
                                <StackLayout Spacing="10">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShopCardTapped" CommandParameter="{Binding .}" />
                                    </StackLayout.GestureRecognizers>

                                    <Grid ColumnDefinitions="45, *" RowSpacing="5">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label Text="⇅" FontSize="24" TextColor="#064E3B" HorizontalOptions="Center"/>
                                            <Label Text="ZIRS" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#064E3B"/>
                                        </StackLayout>

                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="95, *">
                                            <Label Grid.Row="0" Grid.Column="0" Text="SHOP NO" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding ShopNo}" FontSize="13" FontAttributes="Bold" TextColor="#111827" />

                                            <Label Grid.Row="1" Grid.Column="0" Text="OCCUPANT" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentOccupant}" FontSize="11" FontAttributes="Bold" TextColor="#374151" />

                                            <Label Grid.Row="2" Grid.Column="0" Text="CATEGORY" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ShopCat}" FontSize="11" FontAttributes="Bold" TextColor="#374151" />

                                            <Label Grid.Row="3" Grid.Column="0" Text="CAT AMOUNT" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Amount, StringFormat='₦{0}'}" FontSize="11" TextColor="#DC2626" FontAttributes="Bold"/>

                                            <Label Grid.Row="4" Grid.Column="0" Text="PAID" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding TotalAmtPaid, StringFormat='₦{0}'}" FontSize="11" TextColor="#DC2626" FontAttributes="Bold"/>

                                            <Label Grid.Row="5" Grid.Column="0" Text="BALANCE" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding Balance, StringFormat='₦{0}'}" FontSize="11" TextColor="#DC2626" FontAttributes="Bold"/>

                                            <Label Grid.Row="6" Grid.Column="0" Text="LAST DATE" FontSize="11" TextColor="Gray" FontAttributes="Bold"/>
                                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding LastPaymentDate}" FontSize="11" TextColor="#0284C7" FontAttributes="Bold"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Context Button -->
                                    <Button Text="VIEW SHOP DETAILS" 
                                            IsVisible="{Binding IsSelected}"
                                            Clicked="OnViewDetailsClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#064E3B" 
                                            TextColor="White" 
                                            CornerRadius="8" 
                                            HeightRequest="42"
                                            FontAttributes="Bold"
                                            Margin="0,5,0,0"/>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </Frame>
    </StackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.ShopTaxRepaymentPage"
             BackgroundColor="#064E3B">

    <Grid>
        <StackLayout Spacing="0">
            <Label Text="SHOP TAX REPAYMENT" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,15,0,2"/>
            <Label Text="Market Revenue Collection System" TextColor="#D1FAE5" FontSize="10" HorizontalOptions="Center" Margin="0,0,0,15"/>

            <ScrollView BackgroundColor="#F9FAFB">
                <StackLayout Padding="15" Spacing="15">

                    <!-- Notice -->
                    <Frame BackgroundColor="#FEF3C7" BorderColor="#FDE68A" CornerRadius="8" Padding="10" HasShadow="False">
                        <Label Text="⚠ Fields marked with * are required. Please fill them before submitting." 
                               TextColor="#D97706" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    </Frame>

                    <!-- Section: Basic Shop Details -->
                    <Frame CornerRadius="12" Padding="0" BackgroundColor="White" HasShadow="False" BorderColor="#E5E7EB">
                        <StackLayout Spacing="0">
                            <Grid BackgroundColor="#064E3B" Padding="15,10">
                                <Label Text="+  BASIC SHOP DETAILS" FontAttributes="Bold" TextColor="White" FontSize="11" VerticalOptions="Center"/>
                                <Label Text="▼" TextColor="White" HorizontalOptions="End" VerticalOptions="Center" FontSize="10"/>
                            </Grid>

                            <StackLayout Padding="15" Spacing="10">
                                <Label Text="MARKET NAME" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding ShopData.Market}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                </Frame>

                                <Label Text="SHOP NUMBER" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding ShopData.ShopNo}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                </Frame>

                                <Label Text="SHOP OWNER NAME" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding ShopData.Owner}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                </Frame>

                                <Label Text="SHOP CATEGORY" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding ShopData.ShopCategory}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                </Frame>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Section: Payment Details -->
                    <Frame CornerRadius="12" Padding="0" BackgroundColor="White" HasShadow="False" BorderColor="#E5E7EB">
                        <StackLayout Spacing="0">
                            <Grid BackgroundColor="#DC2626" Padding="15,10">
                                <Label Text="+  PAYMENT DETAILS" FontAttributes="Bold" TextColor="White" FontSize="11" VerticalOptions="Center"/>
                                <Label Text="▼" TextColor="White" HorizontalOptions="End" VerticalOptions="Center" FontSize="10"/>
                            </Grid>

                            <StackLayout Padding="15" Spacing="15">
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                    <Frame Grid.Column="0" BackgroundColor="#ECFDF5" Padding="5" CornerRadius="6" HasShadow="False">
                                        <StackLayout Spacing="2">
                                            <Label Text="CATEGORY AMT" FontSize="8" FontAttributes="Bold" TextColor="#065F46" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding ShopData.ShopAmount}" FontSize="10" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>
                                    <Frame Grid.Column="1" BackgroundColor="#FEF3C7" Padding="5" CornerRadius="6" HasShadow="False">
                                        <StackLayout Spacing="2">
                                            <Label Text="PAID SO FAR" FontSize="8" FontAttributes="Bold" TextColor="#D97706" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding ShopData.AmountPaid}" FontSize="10" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>
                                    <Frame Grid.Column="2" BackgroundColor="#FEE2E2" Padding="5" CornerRadius="6" HasShadow="False">
                                        <StackLayout Spacing="2">
                                            <Label Text="BALANCE" FontSize="8" FontAttributes="Bold" TextColor="#B91C1C" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding ShopData.AmountOwed}" FontSize="10" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>
                                </Grid>

                                <!-- Channel Selector -->
                                <Label Text="PAYMENT CHANNEL *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#D1D5DB" HasShadow="False" HeightRequest="45">
                                    <Label Text="{Binding SelectedPaymentChannel}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" VerticalOptions="Center"/>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSelectChannelTapped" />
                                    </Frame.GestureRecognizers>
                                </Frame>

                                <Label Text="PAYMENT REFERENCE *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#D1D5DB" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding PaymentReference}" Placeholder="Enter payment reference" FontSize="13" />
                                </Frame>

                                <Label Text="AMOUNT TO PAY (₦) *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#D1D5DB" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding AmountToPay}" Placeholder="Amount you want to pay" Keyboard="Numeric" FontSize="13" />
                                </Frame>

                                <Label Text="TRANSACTION PIN *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#D1D5DB" HasShadow="False" HeightRequest="45">
                                    <Entry Text="{Binding TransactionPin}" Placeholder="4-digit PIN" IsPassword="True" MaxLength="4" Keyboard="Numeric" FontSize="13" />
                                </Frame>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <Button Text="+    MAKE PAYMENT" 
                            Clicked="OnMakePaymentClicked"
                            BackgroundColor="#064E3B" 
                            TextColor="White" 
                            CornerRadius="10" 
                            HeightRequest="50" 
                            FontAttributes="Bold" 
                            Margin="0,5,0,20"/>
                </StackLayout>
            </ScrollView>
        </StackLayout>

        <!-- MODAL OVERLAY: Payment Channel Selection -->
        <ContentView IsVisible="{Binding IsPopupVisible}" BackgroundColor="#80000000">
            <Frame BackgroundColor="White" CornerRadius="8" Padding="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="280" HasShadow="True">
                <StackLayout Spacing="20">
                    <Label Text="Select Payment Channel" FontAttributes="Bold" FontSize="15" TextColor="#DC2626"/>

                    <Label Text="Remita" FontAttributes="Bold" FontSize="14" TextColor="#111827">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChannelOptionTapped" CommandParameter="Remita" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="PayZamfara" FontAttributes="Bold" FontSize="14" TextColor="#111827">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChannelOptionTapped" CommandParameter="PayZamfara" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="CANCEL" FontAttributes="Bold" FontSize="12" TextColor="#064E3B" HorizontalOptions="End" Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClosePopupTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </Frame>
        </ContentView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.ShopTaxRepaymentPage"
             Title="SHOP TAX REPAYMENT"
             BackgroundColor="#F9FAFB">

    <!-- Root Grid allows overlaying the custom popup -->
    <Grid>
        <ScrollView>
            <StackLayout Padding="15" Spacing="15">

                <!-- Info Banner -->
                <Frame BackgroundColor="#FEF3C7" BorderColor="#FDE68A" CornerRadius="8" Padding="10" HasShadow="False">
                    <Label Text="⚠ Fields marked with * are required. Please fill them before submitting." 
                           TextColor="#D97706" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                </Frame>

                <!-- Basic Shop Details Section -->
                <Frame CornerRadius="12" Padding="0" BackgroundColor="White" HasShadow="False" BorderColor="#E5E7EB">
                    <StackLayout Spacing="0">
                        <Grid BackgroundColor="#064E3B" Padding="15,10">
                            <Label Text="+  BASIC SHOP DETAILS" FontAttributes="Bold" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                            <Image Source="arrow_down_white.png" HorizontalOptions="End" HeightRequest="15"/>
                        </Grid>

                        <StackLayout Padding="15" Spacing="10">
                            <Label Text="MARKET NAME" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding ShopData.Market}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                            </Frame>

                            <Label Text="SHOP NUMBER" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding ShopData.ShopNo}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                            </Frame>

                            <Label Text="SHOP OWNER NAME" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding ShopData.Owner}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                            </Frame>

                            <Label Text="SHOP CATEGORY" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding ShopData.ShopCategory}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Payment Details Section -->
                <Frame CornerRadius="12" Padding="0" BackgroundColor="White" HasShadow="False" BorderColor="#E5E7EB">
                    <StackLayout Spacing="0">
                        <Grid BackgroundColor="#DC2626" Padding="15,10">
                            <Label Text="+  PAYMENT DETAILS" FontAttributes="Bold" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                            <Image Source="arrow_down_white.png" HorizontalOptions="End" HeightRequest="15"/>
                        </Grid>

                        <StackLayout Padding="15" Spacing="15">
                            <!-- Ledger Cards -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                                <Frame Grid.Column="0" BackgroundColor="#ECFDF5" Padding="5" CornerRadius="8" HasShadow="False">
                                    <StackLayout>
                                        <Label Text="CATEGORY AMT" FontSize="9" FontAttributes="Bold" TextColor="#064E3B" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding ShopData.ShopAmount}" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <Frame Grid.Column="1" BackgroundColor="#FEF3C7" Padding="5" CornerRadius="8" HasShadow="False">
                                    <StackLayout>
                                        <Label Text="PAID SO FAR" FontSize="9" FontAttributes="Bold" TextColor="#D97706" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding ShopData.AmountPaid}" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <Frame Grid.Column="2" BackgroundColor="#FCE7F3" Padding="5" CornerRadius="8" HasShadow="False">
                                    <StackLayout>
                                        <Label Text="BALANCE" FontSize="9" FontAttributes="Bold" TextColor="#BE185D" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding ShopData.AmountOwed}" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <!-- Custom Payment Channel Selector -->
                            <Label Text="PAYMENT CHANNEL *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                                <Grid>
                                    <Label Text="{Binding SelectedPaymentChannel}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenChannelPopupCommand}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Frame>

                            <Label Text="PAYMENT REFERENCE *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding PaymentReference}" Placeholder="Enter payment reference" FontSize="13" />
                            </Frame>

                            <Label Text="AMOUNT TO PAY (₦) *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding AmountToPay}" Placeholder="Amount you want to pay" Keyboard="Numeric" FontSize="13" />
                            </Frame>

                            <Label Text="TRANSACTION PIN *" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                            <Frame Padding="10,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                                <Entry Text="{Binding TransactionPin}" Placeholder="4-digit PIN" IsPassword="True" MaxLength="4" Keyboard="Numeric" FontSize="13" />
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <Button Text="+    MAKE PAYMENT" 
                        Command="{Binding ProcessPaymentCommand}"
                        BackgroundColor="#064E3B" 
                        TextColor="White" 
                        CornerRadius="12" 
                        HeightRequest="55" 
                        FontAttributes="Bold" 
                        Margin="0,10,0,30"/>
            </StackLayout>
        </ScrollView>

        <!-- CUSTOM POPUP OVERLAY (Matches 2.14.29 PM screenshot) -->
        <ContentView x:Name="PaymentChannelOverlay" IsVisible="{Binding IsPopupVisible}" BackgroundColor="#80000000">
            <Frame BackgroundColor="White" CornerRadius="4" Padding="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="280" HasShadow="True">
                <StackLayout Spacing="25">
                    <Label Text="Select Payment Channel" FontAttributes="Bold" FontSize="16" TextColor="#DC2626"/>

                    <Label Text="Remita" FontAttributes="Bold" FontSize="14" TextColor="#111827">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectChannelCommand}" CommandParameter="Remita" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="PayZamfara" FontAttributes="Bold" FontSize="14" TextColor="#111827">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectChannelCommand}" CommandParameter="PayZamfara" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="CANCEL" FontAttributes="Bold" FontSize="12" TextColor="#064E3B" HorizontalOptions="End" Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClosePopupCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </Frame>
        </ContentView>
    </Grid>
</ContentPage>
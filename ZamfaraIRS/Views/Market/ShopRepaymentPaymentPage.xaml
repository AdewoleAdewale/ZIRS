<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.ShopRepaymentPaymentPage"
           BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#064E3B" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#64748B" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#CBD5E1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="FieldHeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#64748B"/>
                <Setter Property="CharacterSpacing" Value="0.8"/>
            </Style>

            <Style x:Key="DisplayValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#0F172A"/>
            </Style>

            <Style x:Key="DisplayCardFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="#E2E8F0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BackgroundColor" Value="#F8FAFC" />
            </Style>

            <Style x:Key="InputFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="#CBD5E1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#90000000" Offset="0.0" />
                <GradientStop Color="#C0000000" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!-- SLIDING BOTTOM SHEET CONTAINER -->
        <Frame x:Name="SheetFrame"
               VerticalOptions="End" 
               HorizontalOptions="FillAndExpand"
               BackgroundColor="White"
               CornerRadius="20"
               HasShadow="True"
               Padding="0"
               Margin="0"
               TranslationY="500">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackLayout Grid.Row="0" Padding="0,12,0,8" BackgroundColor="Transparent" HeightRequest="36">
                    <BoxView HeightRequest="5" WidthRequest="45" BackgroundColor="#CBD5E1" HorizontalOptions="Center" CornerRadius="2.5" />
                </StackLayout>

                <ScrollView Grid.Row="1" Padding="22,0,22,25" VerticalScrollBarVisibility="Never">
                    <StackLayout Spacing="12">

                        <!-- FORM VIEW -->
                        <StackLayout x:Name="PaymentFormView" Spacing="12" IsVisible="True">
                            <StackLayout Spacing="4" HorizontalOptions="Center" Margin="0,0,0,4">
                                <Label Text="ZAMFARA STATE INTERNAL REVENUE SERVICE" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#064E3B" />
                                <Label Text="SHOP REPAYMENT COLLECTION" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#047857" />
                            </StackLayout>

                            <!-- Market Selector -->
                            <StackLayout Spacing="4">
                                <Label Text="SELECT MARKET / COMPLEX *" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                <Frame Style="{StaticResource InputFrameStyle}">
                                    <Picker x:Name="MarketPicker" ItemDisplayBinding="{Binding Market_Plaza}" SelectedIndexChanged="OnMarketSelected" />
                                </Frame>
                            </StackLayout>

                            <!-- Shop & Occupant Verification Inputs -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="SHOP NUMBER *" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                    <Frame Style="{StaticResource InputFrameStyle}">
                                        <Entry x:Name="txtShopNo" Placeholder="e.g. GCM014" FontSize="13" TextChanged="OnInputChanged" />
                                    </Frame>
                                </StackLayout>

                                <StackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="OCCUPANT NAME *" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                    <Frame Style="{StaticResource InputFrameStyle}">
                                        <Entry x:Name="txtOccupant" Placeholder="e.g. Jane Doe" FontSize="13" TextChanged="OnInputChanged" />
                                    </Frame>
                                </StackLayout>
                            </Grid>

                            <Button x:Name="BtnVerifyShop" Text="VERIFY SHOP DETAILS" Clicked="OnVerifyShopClicked" BackgroundColor="#047857" TextColor="White" CornerRadius="10" HeightRequest="44" FontSize="12" FontAttributes="Bold" />

                            <!-- Verified Data Display Card -->
                            <StackLayout x:Name="VerifiedDetailsContainer" IsVisible="False" Spacing="10">
                                <Frame Style="{StaticResource DisplayCardFrameStyle}">
                                    <Grid ColumnDefinitions="*, *">
                                        <StackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="CATEGORY RATE" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                            <Label x:Name="lblCategoryRate" Text="₦0.00" Style="{StaticResource DisplayValueLabelStyle}"/>
                                        </StackLayout>
                                        <StackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="CURRENT AMOUNT OWED" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                            <Label x:Name="lblAmountOwed" Text="₦0.00" Style="{StaticResource DisplayValueLabelStyle}" TextColor="#DC2626"/>
                                        </StackLayout>
                                    </Grid>
                                </Frame>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="MONTHS" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                        <Frame Style="{StaticResource InputFrameStyle}">
                                            <Entry x:Name="txtMonths" Text="1" Keyboard="Numeric" TextChanged="OnMonthsChanged" />
                                        </Frame>
                                    </StackLayout>

                                    <StackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="CALCULATED AMOUNT (₦)" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                        <Frame Style="{StaticResource InputFrameStyle}">
                                            <Entry x:Name="txtPayAmount" IsReadOnly="True" FontAttributes="Bold" TextColor="#065F46" />
                                        </Frame>
                                    </StackLayout>
                                </Grid>

                                <StackLayout Spacing="4">
                                    <Label Text="AGENT SECURITY PIN *" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                    <Frame Style="{StaticResource InputFrameStyle}">
                                        <Entry x:Name="txtPin" Placeholder="4-Digit PIN" IsPassword="True" MaxLength="4" Keyboard="Numeric" TextChanged="OnPinTextChanged" />
                                    </Frame>
                                </StackLayout>

                                <Button x:Name="BtnSubmitPayment" Text="SUBMIT REPAYMENT" Clicked="OnSubmitPaymentClicked" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                            </StackLayout>

                            <Button Text="CANCEL" Clicked="OnCancelClicked" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackLayout>

                        <!-- SUCCESS SHEET VIEW -->
                        <StackLayout x:Name="PaymentSuccessView" Spacing="14" IsVisible="False">
                            <StackLayout Spacing="4" HorizontalOptions="Center" Margin="0,4,0,2">
                                <Label Text="✓" FontSize="44" FontAttributes="Bold" TextColor="#059669" HorizontalOptions="Center"/>
                                <Label Text="Repayment Successful!" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center"/>
                                <Label Text="Payment record synchronized with ZIRS" FontSize="12" TextColor="#64748B" HorizontalOptions="Center"/>
                            </StackLayout>

                            <Frame BackgroundColor="#F0FDF4" BorderColor="#BBF7D0" CornerRadius="12" Padding="16" HasShadow="False">
                                <StackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Grid.Column="0" Text="Reference:" FontSize="12" TextColor="#64748B"/>
                                        <Label Grid.Column="1" x:Name="lblSuccessRef" Text="---" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Grid.Column="0" Text="Shop Number:" FontSize="12" TextColor="#64748B"/>
                                        <Label Grid.Column="1" x:Name="lblSuccessShopNo" Text="---" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Grid.Column="0" Text="Occupant:" FontSize="12" TextColor="#64748B"/>
                                        <Label Grid.Column="1" x:Name="lblSuccessOccupant" Text="---" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <BoxView HeightRequest="1" BackgroundColor="#DCFCE7"/>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Label Grid.Column="0" Text="Amount Paid:" FontSize="13" FontAttributes="Bold" TextColor="#065F46"/>
                                        <Label Grid.Column="1" x:Name="lblSuccessAmountPaid" Text="₦0.00" FontSize="15" FontAttributes="Bold" TextColor="#059669" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </Frame>

                            <StackLayout Spacing="8" Margin="0,6,0,0">
                                <Button x:Name="BtnReprintReceipt" Text="🖨️ REPRINT RECEIPT" Clicked="OnReprintReceiptClicked" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Text="NEW TRANSACTION" Clicked="OnNewTransactionClicked" BackgroundColor="#059669" TextColor="White" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
                            </StackLayout>
                        </StackLayout>

                    </StackLayout>
                </ScrollView>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.Dashboard" 
           BackgroundColor="#064E3B"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!-- Header Profile & Logout -->
        <Grid Grid.Row="0" Padding="20, 40, 20, 10" ColumnDefinitions="Auto, *, Auto, Auto">
            <Frame Grid.Column="0" CornerRadius="6" HeightRequest="32" WidthRequest="32" BackgroundColor="White" Padding="0" HasShadow="False">
                <Image Source="zirs" VerticalOptions="Center" HorizontalOptions="Center" Aspect="AspectFit" Margin="5"  />
            </Frame>
            <StackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                <Label Text="Good afternoon" FontSize="11" TextColor="#A7F3D0" />
                <Label Text="{Binding AgentName}" FontSize="15" FontAttributes="Bold" TextColor="White" />
            </StackLayout>
            <Button Grid.Column="2" Text="⋯" BackgroundColor="#047857" TextColor="White" CornerRadius="12" WidthRequest="40" HeightRequest="40" Command="{Binding OpenOptionsCommand}" />
            <Button Grid.Column="3"  ImageSource="shutdown" Margin="6,0,0,0" BackgroundColor="#DC2626"   TextColor="White" CornerRadius="12" WidthRequest="40" HeightRequest="40" Command="{Binding LogoutCommand}" />
        </Grid>

        <!-- Current Office / LGA Card -->
        <Frame Grid.Row="1" Margin="20, 5" CornerRadius="12" BackgroundColor="#047857" Padding="12" HasShadow="False">
            <Grid ColumnDefinitions="4, *">
                <BoxView BackgroundColor="#F97316" WidthRequest="4" CornerRadius="2" />
                <StackLayout Grid.Column="1" Margin="10,0,0,0">
                    <Label Text="{Binding MarketLocationName}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding MarketLocationSub}" FontSize="10" TextColor="#D1FAE5" />
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Stats Overview -->
        <StackLayout Grid.Row="2" Padding="20, 10" Spacing="4">
            <Label Text="Collected today" FontSize="12" TextColor="#D1FAE5" />
            <Label Text="{Binding TodayCollected, StringFormat='₦{0:N0}'}" FontSize="32" FontAttributes="Bold" TextColor="White" />
            <Label Text="No payments recorded yet today" FontSize="11" TextColor="#A7F3D0" Margin="0,0,0,8" />

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                <Frame Grid.Column="0" CornerRadius="12" BackgroundColor="#047857" Padding="10" HasShadow="False">
                    <StackLayout>
                        <Label Text="{Binding PaymentsCount}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Payments" FontSize="10" TextColor="#D1FAE5" />
                    </StackLayout>
                </Frame>
                <Frame Grid.Column="1" CornerRadius="12" BackgroundColor="#047857" Padding="10" HasShadow="False">
                    <StackLayout>
                        <Label Text="—" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Avg ticket" FontSize="10" TextColor="#D1FAE5" />
                    </StackLayout>
                </Frame>
                <Frame Grid.Column="2" CornerRadius="12" BackgroundColor="#047857" Padding="10" HasShadow="False">
                    <StackLayout>
                        <Label Text="₦" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Last 7 days" FontSize="10" TextColor="#D1FAE5" />
                    </StackLayout>
                </Frame>
            </Grid>
        </StackLayout>

        <!-- Main Workspace (Light Background Sheet) -->
        <Frame Grid.Row="3" BackgroundColor="#F3F4F6" CornerRadius="15" Margin="0, 10, 0, 0" Padding="16, 20, 16, 0" HasShadow="False">
            <ScrollView VerticalScrollBarVisibility="Never">
                <StackLayout Spacing="16">

                    <!-- Printer Status Indicators -->
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Frame CornerRadius="8" BackgroundColor="#DCFCE7" Padding="8,4" HasShadow="False">
                            <Label Text="Online" FontSize="11" TextColor="#15803D" FontAttributes="Bold" />
                        </Frame>
                        <Frame CornerRadius="8" BackgroundColor="#FEF3C7" Padding="8,4" HasShadow="False">
                            <Label Text="Printer Ready" FontSize="11" TextColor="#B45309" FontAttributes="Bold" />
                        </Frame>
                    </StackLayout>

                    <!-- Big Action: New Payment -->
                    <Frame CornerRadius="14" BackgroundColor="#064E3B" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewPaymentTapped" NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <StackLayout>
                                <Label Text="New payment" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                <Label Text="Verify shop, calculate rate, collect" FontSize="12" TextColor="#A7F3D0" />
                            </StackLayout>
                            <Label Grid.Column="1" Text="➔" FontSize="20" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <!-- Action Grid Icons -->
                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">

                        <!-- Register Shop -->
                        <Frame Grid.Column="0" CornerRadius="14" BackgroundColor="White" Padding="8" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEnumerateTapped" NumberOfTapsRequired="1" />
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame CornerRadius="10" BackgroundColor="#D1FAE5" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False">
                                    <Image Source="check" Margin="1" HeightRequest="30"   HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <Label Text="Shops" FontSize="11" FontAttributes="Bold" TextColor="#374151" HorizontalOptions="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- History -->
                        <Frame Grid.Column="1" CornerRadius="14" BackgroundColor="White" Padding="8" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHistoryTapped" NumberOfTapsRequired="1" />
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame CornerRadius="10" BackgroundColor="#DBEAFE" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False">
                                    <Image Source="yobehistory" Margin="1" HeightRequest="30"   HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <Label Text="History" FontSize="11" FontAttributes="Bold" TextColor="#374151" HorizontalOptions="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Test Print -->
                        <Frame Grid.Column="2" CornerRadius="14" BackgroundColor="White" Padding="8" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTestPrintTapped" NumberOfTapsRequired="1" />
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame CornerRadius="10" BackgroundColor="#FFEDD5" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False">
                                    <Image Source="print" Margin="1" HeightRequest="30"   HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <Label Text="Test print" FontSize="11" FontAttributes="Bold" TextColor="#374151" HorizontalOptions="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Security / Settings -->
                        <Frame Grid.Column="3" CornerRadius="14" BackgroundColor="White" Padding="8" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" NumberOfTapsRequired="1" />
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame CornerRadius="10" BackgroundColor="#EDE9FE" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False">
                                    <Image Source="add" Margin="1" HeightRequest="30"   HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <Label Text="Settings" FontSize="11" FontAttributes="Bold" TextColor="#374151" HorizontalOptions="Center" />
                            </StackLayout>
                        </Frame>
                    </Grid>

                    <!-- Recent Activity Section -->
                    <StackLayout Margin="0, 10, 0, 80">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Recent activity" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            <Label Grid.Column="1" Text="See all" FontSize="12" TextColor="#047857" FontAttributes="Bold" />
                        </Grid>

                        <StackLayout BindableLayout.ItemsSource="{Binding RecentActivities}" Spacing="8" Margin="0,10,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame CornerRadius="12" BackgroundColor="White" Padding="12" HasShadow="False">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Frame CornerRadius="8" BackgroundColor="#E0F2FE" HeightRequest="32" WidthRequest="32" Padding="0" HasShadow="False">
                                                <Image Source="zirs" HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit" HeightRequest="30" />
                                            </Frame>
                                            <StackLayout Grid.Column="1" Margin="10,0,0,0">
                                                <Label Text="{Binding ShopNo}" FontAttributes="Bold" FontSize="13" TextColor="#1F2937" />
                                                <Label Text="{Binding RecordedBy, StringFormat='Market Entry • {0}'}" FontSize="11" TextColor="#6B7280" />
                                            </StackLayout>
                                            <StackLayout Grid.Column="2" HorizontalOptions="End">
                                                <Label Text="{Binding Amount, StringFormat='₦{0}'}" FontAttributes="Bold" FontSize="13" TextColor="#111827" HorizontalOptions="End" />
                                                <Label Text="Paid" FontSize="10" TextColor="#047857" FontAttributes="Bold" HorizontalOptions="End" />
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </StackLayout>

                </StackLayout>
            </ScrollView>
        </Frame>

        <!-- Center-FAB Bottom Navigation Bar -->
        <Grid Grid.Row="4" HeightRequest="70" BackgroundColor="Transparent">
            <Frame BackgroundColor="White" CornerRadius="20" Margin="0" Padding="20,0" HasShadow="True">
                <Grid ColumnDefinitions="*, *, 60, *, *">
                    <StackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="⌂" FontSize="20" TextColor="#064E3B" HorizontalOptions="Center" />
                        <Label Text="Home" FontSize="10" TextColor="#064E3B" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>

                    <StackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExploreTapped" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                        <Label Text="🔍" FontSize="18" TextColor="#064E3B" HorizontalOptions="Center" InputTransparent="True" />
                        <Label Text="Explore" FontSize="10" TextColor="#064E3B" HorizontalOptions="Center" InputTransparent="True" />
                    </StackLayout>

                    <StackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryTapped" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                        <Label Text="◷" FontSize="18" TextColor="#064E3B" HorizontalOptions="Center" InputTransparent="True" />
                        <Label Text="History" FontSize="10" TextColor="#064E3B" HorizontalOptions="Center" InputTransparent="True" />
                    </StackLayout>

                    <StackLayout Grid.Column="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                        <Label Text="👤" FontSize="18" TextColor="#064E3B" HorizontalOptions="Center" InputTransparent="True" />
                        <Label Text="Profile" FontSize="10" TextColor="#064E3B" HorizontalOptions="Center" InputTransparent="True" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Floating Center Add Action Button (FAB) -->
            <Button Text="+" 
                    TextColor="White" 
                    FontSize="28" 
                    FontAttributes="Bold" 
                    BackgroundColor="#064E3B" 
                    WidthRequest="56" 
                    HeightRequest="56" 
                    CornerRadius="28" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Start" 
                    Margin="0,-20,0,0" 
                    Clicked="OnCenterFabClicked" />
        </Grid>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.MarketShopsPage"
             Title="Market Shops Directory">
    <StackLayout Padding="10">
        <Picker ItemsSource="{Binding Markets}" 
                ItemDisplayBinding="{Binding Market_Plaza}" 
                SelectedItem="{Binding SelectedMarket}" 
                Title="Select Market to View Shops" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <ListView ItemsSource="{Binding Shops}" 
                  HasUnevenRows="True" 
                  SeparatorVisibility="Default">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="10" Spacing="4">
                            <Label Text="{Binding ShopNo, StringFormat='Shop No: {0}'}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding ShopCat, StringFormat='Category: {0}'}" FontSize="13" TextColor="Gray" />
                            <Label Text="{Binding CurrentOccupant, StringFormat='Occupant: {0}'}" FontSize="13" />
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Balance, StringFormat='Balance: ₦{0}'}" TextColor="Red" FontSize="12" />
                                <Label Text="{Binding TotalAmtPaid, StringFormat='Paid: ₦{0}'}" TextColor="Green" FontSize="12" />
                            </StackLayout>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>
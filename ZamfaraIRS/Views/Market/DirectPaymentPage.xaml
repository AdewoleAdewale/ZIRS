<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Market.DirectPaymentPage"
             BackgroundColor="#064E3B">

    <Grid>
        <!-- MAIN UI -->
        <StackLayout Spacing="0">
            <Grid ColumnDefinitions="*, Auto" Padding="20,10">
                <Label Grid.Column="0" Text="DIRECT PAYMENT" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                <Image Grid.Column="1" Source="zirs.png" HeightRequest="60" WidthRequest="60" VerticalOptions="Center" />
            </Grid>

            <Frame CornerRadius="24" BackgroundColor="#F9FAFB" Padding="20" HasShadow="False" VerticalOptions="FillAndExpand">
                <ScrollView>
                    <StackLayout Spacing="15">
                        <Label Text="SHOP NUMBER" FontSize="11" FontAttributes="Bold" TextColor="#064E3B" />
                        <Frame Padding="12,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="48">
                            <Entry Text="{Binding ShopNumber}" IsReadOnly="True" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                        </Frame>

                        <Label Text="ZIRS PORTAL MESSAGE" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" />
                        <Frame Padding="12,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="48">
                            <Entry Text="{Binding PortalMessage}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#374151"/>
                        </Frame>

                        <Label Text="MONTHS *" FontSize="11" FontAttributes="Bold" TextColor="#064E3B" />
                        <Frame Padding="12,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="48">
                            <Entry Text="{Binding MonthsInput}" Placeholder="e.g., 3" Keyboard="Numeric" FontSize="14" FontAttributes="Bold" TextColor="#111827" TextChanged="OnMonthsChanged"/>
                        </Frame>

                        <Label Text="AMOUNT TO BE PAID (₦)" FontSize="11" FontAttributes="Bold" TextColor="#064E3B" />
                        <Frame Padding="12,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="48">
                            <Entry Text="{Binding Amount}" IsReadOnly="True" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                        </Frame>

                        <Label Text="PIN *" FontSize="11" FontAttributes="Bold" TextColor="#064E3B" />
                        <Frame Padding="12,0" CornerRadius="8" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False" HeightRequest="48">
                            <Entry Text="{Binding PinInput}" Placeholder="4-digit PIN" IsPassword="True" MaxLength="4" Keyboard="Numeric" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                        </Frame>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#064E3B" HorizontalOptions="Center" Margin="0,10" />

                        <Button Text="PROCESS SHOP PAYMENT" 
                                Command="{Binding ProcessPaymentCommand}"
                                BackgroundColor="#064E3B" 
                                TextColor="White" 
                                CornerRadius="10" 
                                HeightRequest="55" 
                                FontAttributes="Bold"
                                Margin="0,15,0,30" />
                    </StackLayout>
                </ScrollView>
            </Frame>
        </StackLayout>

        <!-- SUCCESS BOTTOM SHEET -->
        <ContentView IsVisible="{Binding ShowSuccessSheet}" BackgroundColor="#80000000" VerticalOptions="FillAndExpand">
            <StackLayout VerticalOptions="End" BackgroundColor="White" Padding="24" Spacing="14">
                <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#E5E7EB" HorizontalOptions="Center" CornerRadius="2" />
                <Label Text="✓" FontSize="42" TextColor="#059669" HorizontalOptions="Center" />
                <Label Text="Payment Successful" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#111827" />
                <Label Text="{Binding Amount, StringFormat='Amount Paid: ₦{0}'}" FontSize="16" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#064E3B" />

                <Button Text="🖨️ Print Receipt" Command="{Binding PrintReceiptCommand}" BackgroundColor="#064E3B" TextColor="White" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" />
                <Button Text="Done" Command="{Binding DismissSheetsCommand}" BackgroundColor="#F3F4F6" TextColor="#374151" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" />
            </StackLayout>
        </ContentView>

        <!-- ERROR BOTTOM SHEET -->
        <ContentView IsVisible="{Binding ShowErrorSheet}" BackgroundColor="#80000000" VerticalOptions="FillAndExpand">
            <StackLayout VerticalOptions="End" BackgroundColor="White" Padding="24" Spacing="14">
                <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#E5E7EB" HorizontalOptions="Center" CornerRadius="2" />
                <Label Text="✕" FontSize="42" TextColor="#DC2626" HorizontalOptions="Center" />
                <Label Text="Payment Failed" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#111827" />

                <Frame BackgroundColor="#FEF2F2" BorderColor="#FECACA" CornerRadius="8" Padding="12" HasShadow="False">
                    <Label Text="{Binding ErrorMessage}" FontSize="14" HorizontalOptions="Center" TextColor="#991B1B" HorizontalTextAlignment="Center" />
                </Frame>

                <Button Text="Retry / Edit Details" Command="{Binding DismissSheetsCommand}" BackgroundColor="#DC2626" TextColor="White" CornerRadius="8" HeightRequest="50" FontAttributes="Bold"/>
            </StackLayout>
        </ContentView>
    </Grid>
</ContentPage>
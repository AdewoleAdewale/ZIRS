<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Keke.KekeServicesPage"
             BackgroundColor="#F3F4F6"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Banner -->
        <StackLayout Grid.Row="0" BackgroundColor="#064E3B" Padding="20,40,20,40" Spacing="10">
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                <Label Text=".ZIRS" TextColor="White" FontSize="24" FontAttributes="Bold" />
            </StackLayout>
            <Label Text="ZAMFARA INTERNAL REVENUE SERVICE" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />

            <Frame BackgroundColor="White" CornerRadius="15" Padding="15,5" HasShadow="False" HorizontalOptions="Center" Margin="0,10,0,0">
                <Label Text="Services loaded" TextColor="#064E3B" FontSize="12" FontAttributes="Bold" />
            </Frame>
        </StackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Margin="0,-25,0,0">
            <StackLayout Padding="20" Spacing="15">

                <!-- Status Cards -->
                <Grid ColumnDefinitions="*, 2*">
                    <Frame Grid.Column="0" BackgroundColor="#059669" CornerRadius="12" Padding="15" HasShadow="True">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="{Binding CurrentDay}" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="{Binding CurrentMonth}" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextTransform="Uppercase" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="12" Padding="15" HasShadow="True">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                            <Label Text="OSOFT PAY" TextColor="#DC2626" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="PAYMENT SERVICES" TextColor="#111827" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,5,0,0">
                                <BoxView Color="#10B981" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                                <Label Text="ONLINE" TextColor="#10B981" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </Grid>

                <Frame BackgroundColor="White" CornerRadius="12" Padding="15" HasShadow="False">
                    <Label Text="{Binding Services.Count, StringFormat='Available Services ({0})'}" FontAttributes="Bold" FontSize="14" TextColor="#064E3B" HorizontalOptions="Center" />
                </Frame>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#064E3B" HorizontalOptions="Center" />

                <!-- Dynamic Services List -->
                <CollectionView ItemsSource="{Binding Services}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5,0,10" Padding="15" CornerRadius="12" BackgroundColor="White" HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectServiceCommand}" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Frame Grid.Column="0" BackgroundColor="#064E3B" CornerRadius="10" HeightRequest="50" WidthRequest="50" Padding="5" HasShadow="False">
                                        <Image Source="zirs.png" />
                                    </Frame>
                                    <StackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding ServiceName}" FontAttributes="Bold" FontSize="13" TextColor="#111827" />
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="Description:" FontSize="11" TextColor="Gray" />
                                            <Label Text="{Binding ServiceDescription}" FontSize="11" FontAttributes="Bold" TextColor="#374151" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="Amount:" FontSize="11" TextColor="Gray" />
                                            <Label Text="{Binding ServiceAmount, StringFormat='₦{0}'}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" />
                                        </StackLayout>
                                    </StackLayout>
                                    <Label Grid.Column="2" Text="▼" TextColor="#DC2626" FontSize="12" VerticalOptions="End" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding Services.Count, StringFormat='You have {0} revenue head available'}" TextColor="#DC2626" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
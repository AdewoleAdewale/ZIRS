<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Keke.KekeStatusCheckerPage"
             BackgroundColor="#064E3B"
             NavigationPage.HasNavigationBar="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <StackLayout Spacing="20" Padding="20,40,20,20">

            <!-- Header -->
            <StackLayout HorizontalOptions="Center" Spacing="5">
                <Image Source="zamfara_seal.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
                <Label Text="KEKE STATUS CHECKER" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Verify your tricycle payment status instantly" TextColor="#A7F3D0" FontSize="12" HorizontalOptions="Center" />
            </StackLayout>

            <!-- Input Container -->
            <Frame BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="False" Margin="0,10,0,0">
                <StackLayout Spacing="15">

                    <Label Text="Enter Keke Number" FontAttributes="Bold" FontSize="13" TextColor="#1F2937" />

                    <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#F9FAFB" HasShadow="False" BorderColor="#D1D5DB" HeightRequest="50">
                        <Entry Text="{Binding KekeNumber}" Placeholder="e.g. Gus202" FontSize="14" FontAttributes="Bold" TextColor="#111827" TextTransform="Uppercase" />
                    </Frame>

                    <Label Text="Enter 3-20 alphanumeric characters" FontSize="10" TextColor="#6B7280" />

                    <Button Text="GET KEKE PAYMENT STATUS" 
                            Command="{Binding CheckStatusCommand}" 
                            BackgroundColor="#064E3B" 
                            TextColor="White" 
                            CornerRadius="8" 
                            HeightRequest="50" 
                            FontAttributes="Bold" 
                            Margin="0,5,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#064E3B" HorizontalOptions="Center" Margin="0,10" />

                    <!-- Sophisticated Result Section -->
                    <StackLayout IsVisible="{Binding HasResult}" Spacing="15" Margin="0,10,0,0">

                        <!-- Body Number Header -->
                        <Frame BackgroundColor="#064E3B" CornerRadius="8" Padding="15,10" HasShadow="False">
                            <StackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="BODY NUMBER" FontSize="10" FontAttributes="Bold" TextColor="#A7F3D0" HorizontalOptions="Center" />
                                <Label Text="{Binding Result.KekeNo}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" TextTransform="Uppercase" />
                            </StackLayout>
                        </Frame>

                        <!-- Logos & Vehicle Type -->
                        <StackLayout Spacing="10" Margin="0,10">
                            <Grid ColumnDefinitions="*, *" HorizontalOptions="Center" WidthRequest="200">
                                <Image Grid.Column="0" Source="zirs.png" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" />
                                <Image Grid.Column="1" Source="osoft.png" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" />
                            </Grid>

                            <Label Text="VEHICLE TYPE" FontSize="10" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" Margin="0,10,0,0" />
                            <Label Text="{Binding Result.VehicleType}" FontSize="14" FontAttributes="Bold" TextColor="#DC2626" HorizontalOptions="Center" />
                        </StackLayout>

                        <!-- Payment Status Card -->
                        <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="True" BorderColor="#E5E7EB">
                            <StackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="PAYMENT STATUS" FontSize="10" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
                                <Label Text="{Binding Result.Message}" FontSize="16" FontAttributes="Bold" TextColor="{Binding StatusTextColor}" HorizontalOptions="Center" />
                                <Label Text="{Binding Result.LastExpDat, StringFormat='EXPIRY DATE: {0}'}" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" HorizontalOptions="Center" Margin="0,5,0,0" />
                            </StackLayout>
                        </Frame>

                        <!-- More Information Card -->
                        <Frame BackgroundColor="#F9FAFB" CornerRadius="12" Padding="20" HasShadow="True" BorderColor="#E5E7EB">
                            <StackLayout Spacing="12">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="ℹ️" FontSize="12" VerticalOptions="Center" />
                                    <Label Text="MORE INFORMATION" FontSize="11" FontAttributes="Bold" TextColor="#064E3B" VerticalOptions="Center" />
                                </StackLayout>

                                <Label Text="ZAMFARA INTERNAL REVENUE SERVICE&#10;(ZIRS)" FontSize="12" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="Center" />

                                <Frame BackgroundColor="#EFF6FF" CornerRadius="8" Padding="15" HasShadow="False">
                                    <StackLayout Spacing="8">
                                        <Label Text="📌 IMPORTANT NOTES" FontSize="10" FontAttributes="Bold" TextColor="#1E3A8A" />
                                        <Label Text="• This shows the payment status for the entered Keke number" FontSize="10" TextColor="#1E40AF" />
                                        <Label Text="• Please check the expiry date of your last payment" FontSize="10" TextColor="#1E40AF" />
                                        <Label Text="• Ensure your payments are up to date to avoid penalties" FontSize="10" TextColor="#1E40AF" />
                                    </StackLayout>
                                </Frame>

                                <!-- Barcode Simulation -->
                                <StackLayout HorizontalOptions="Center" Margin="0,10,0,0">
                                    <Label Text="VERIFICATION CODE" FontSize="9" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,5" />
                                    <Label Text="|||||||| |||||| |||||||||||| ||||||||" FontFamily="monospace" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
                                    <Label Text="zamfara.osoftpay.net" FontSize="9" HorizontalOptions="Center" TextColor="Gray" />
                                </StackLayout>
                            </StackLayout>
                        </Frame>

                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Footer -->
            <StackLayout VerticalOptions="EndAndExpand" Spacing="5" HorizontalOptions="Center" Margin="0,20,0,0">
                <Label Text="Powered by Zamfara Internal Revenue Service" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="For support, contact: support@zirs.gov.ng" TextColor="#A7F3D0" FontSize="10" HorizontalOptions="Center" />
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
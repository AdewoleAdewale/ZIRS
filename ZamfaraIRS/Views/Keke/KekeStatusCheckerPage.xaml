<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Keke.KekeStatusCheckerPage"
             BackgroundColor="#064E3B"
             NavigationPage.HasNavigationBar="False">
    <StackLayout Spacing="20" Padding="20,40,20,20">

        <StackLayout HorizontalOptions="Center" Spacing="5">
            <Image Source="zamfara_seal.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" />
            <Label Text="KEKE STATUS CHECKER" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Verify your tricycle payment status instantly" TextColor="#A7F3D0" FontSize="12" HorizontalOptions="Center" />
        </StackLayout>

        <Frame BackgroundColor="White" CornerRadius="12" Padding="20" HasShadow="False" Margin="0,20,0,0">
            <StackLayout Spacing="15">
                <Label Text="Enter Keke Number" FontAttributes="Bold" FontSize="14" TextColor="#1F2937" />

                <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#F3F4F6" HasShadow="False" BorderColor="#E5E7EB" HeightRequest="50">
                    <Entry Text="{Binding KekeNumber}" Placeholder="e.g., KK12345, ABC789" FontSize="14" FontAttributes="Bold" TextColor="#111827" TextTransform="Uppercase" />
                </Frame>

                <Label Text="Enter 3-20 alphanumeric characters" FontSize="10" TextColor="#6B7280" />

                <Button Text="GET KEKE PAYMENT STATUS" 
                        Command="{Binding CheckStatusCommand}" 
                        BackgroundColor="#D1D5DB" 
                        TextColor="#9CA3AF" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold" 
                        Margin="0,10,0,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsValidInput}" Value="True">
                            <Setter Property="BackgroundColor" Value="#059669" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </Frame>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HorizontalOptions="Center" Margin="0,20,0,0" />

        <StackLayout VerticalOptions="EndAndExpand" Spacing="5" HorizontalOptions="Center">
            <Label Text="Powered by Zamfara Internal Revenue Service" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="For support, contact: support@zirs.gov.ng" TextColor="#A7F3D0" FontSize="10" HorizontalOptions="Center" />
        </StackLayout>
    </StackLayout>
</ContentPage>
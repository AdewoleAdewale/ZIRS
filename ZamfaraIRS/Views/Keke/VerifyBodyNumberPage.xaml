<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZamfaraIRS.Views.Keke.VerifyBodyNumberPage"
             BackgroundColor="#064E3B"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- MAIN VERIFICATION UI -->
        <StackLayout Spacing="20" Padding="20,40,20,20">
            <StackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="VERIFY ID FOR PAYMENT" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Enter your body number to verify payment details" TextColor="#A7F3D0" FontSize="12" HorizontalOptions="Center" />
            </StackLayout>

            <!-- Input Card -->
            <Frame BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="False" Margin="0,10,0,0">
                <StackLayout Spacing="15">
                    <Label Text="BODY NUMBER" FontAttributes="Bold" FontSize="13" TextColor="#064E3B" />
                    <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#F9FAFB" HasShadow="False" BorderColor="#E5E7EB" HeightRequest="50">
                        <Entry Text="{Binding BodyNumberInput}" Placeholder="e.g. Gus202" FontSize="14" FontAttributes="Bold" TextColor="#111827" TextTransform="Uppercase" />
                    </Frame>
                    <Button Text="VERIFY BODY NUMBER" Clicked="OnVerifyClicked" BackgroundColor="#064E3B" TextColor="White" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" />
                </StackLayout>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HorizontalOptions="Center" />

            <!-- Verification Result Card -->
            <Frame BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="False" IsVisible="{Binding HasResult}">
                <StackLayout Spacing="15">
                    <Label Text="BODY NUMBER DETAILS" FontAttributes="Bold" FontSize="14" TextColor="#064E3B" HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Frame BackgroundColor="#6B7280" CornerRadius="12" Padding="15,6" HasShadow="False" HorizontalOptions="Start">
                        <Label Text="{Binding VerificationResult.Message}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                    </Frame>

                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="15">
                        <StackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="BODY NUMBER" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding VerificationResult.KekeNo}" FontSize="13" FontAttributes="Bold" TextColor="#111827" TextTransform="Uppercase"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="VEHICLE TYPE" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding VerificationResult.VehicleType}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" />
                        </StackLayout>

                        <StackLayout Grid.Row="1" Grid.Column="0">
                            <Label Text="SERVICE NAME" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding VerificationResult.ServiceName}" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                        </StackLayout>
                        <StackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="AMOUNT" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding VerificationResult.ServiceAmt}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" />
                        </StackLayout>

                        <StackLayout Grid.Row="2" Grid.Column="0">
                            <Label Text="DAYS PAID FOR" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding VerificationResult.DayDiff}" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                        </StackLayout>
                        <StackLayout Grid.Row="2" Grid.Column="1">
                            <Label Text="EXPIRY DATE" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding VerificationResult.LastExpDat}" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                        </StackLayout>
                    </Grid>

                    <!-- Button to OPEN the payment sheet (Do not bind payment execution here) -->
                    <Button Text="MAKE PAYMENT" Clicked="OnOpenPaymentSheetClicked"  BackgroundColor="#005A9C"  TextColor="White" />

                    <!-- ... Inside your Bottom Sheet / Popup UI ... -->
                    <Frame IsVisible="{Binding ShowPaymentSheet}">
                        <StackLayout>
                            <Label Text="Enter PIN to Confirm" />
                            <Entry Text="{Binding EnteredPin}" IsPassword="True" Placeholder="****" />

                            <!-- Button to actually SUBMIT the payment -->
                            <Button Text="Confirm Payment" 
                Clicked="OnConfirmPaymentClicked" 
                BackgroundColor="#2E7D32" 
                TextColor="White" />
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </Frame>
        </StackLayout>

        <!-- PAYMENT BOTTOM SHEET -->
        <ContentView IsVisible="{Binding ShowPaymentSheet}" BackgroundColor="#80000000" VerticalOptions="FillAndExpand">
            <StackLayout VerticalOptions="End" BackgroundColor="#F3F4F6" Padding="20,20,20,40" Spacing="15" >
                <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#D1D5DB" HorizontalOptions="Center" CornerRadius="2" Margin="0,0,0,10"/>
                <Label Text="COLLECT TAX FROM TAXPAYER" FontSize="16" FontAttributes="Bold" TextColor="#064E3B" HorizontalOptions="Center" Margin="0,0,0,10" />

                <!-- Dynamic Form -->
                <Label Text="SERVICE NAME" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                    <Entry Text="{Binding VerificationResult.ServiceName}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#6B7280" />
                </Frame>

                <Grid ColumnDefinitions="*, *">
                    <StackLayout Grid.Column="0">
                        <Label Text="PAYER ID" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                        <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                            <Entry Text="{Binding VerificationResult.KekeNo}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#6B7280" />
                        </Frame>
                    </StackLayout>
                    <StackLayout Grid.Column="1">
                        <Label Text="RATE (₦)" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                        <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#E5E7EB" HasShadow="False" HeightRequest="45">
                            <Entry Text="{Binding VerificationResult.ServiceAmt}" IsReadOnly="True" FontSize="13" FontAttributes="Bold" TextColor="#6B7280" />
                        </Frame>
                    </StackLayout>
                </Grid>

                <Label Text="NUMBER OF DAYS (1-12) *" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                <Frame Padding="15,0" CornerRadius="8" BackgroundColor="White" BorderColor="#D1D5DB" HasShadow="False" HeightRequest="45">
                    <Picker ItemsSource="{Binding DaysOptions}" SelectedItem="{Binding SelectedDays}" Title="Select Days" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                </Frame>

                <Label Text="TOTAL AMOUNT TO PAY (₦)" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                <Frame Padding="15,0" CornerRadius="8" BackgroundColor="#FEF3C7" BorderColor="#FDE68A" HasShadow="False" HeightRequest="45">
                    <Entry Text="{Binding TotalAmountToPay, StringFormat='{0:N2}'}" IsReadOnly="True" FontSize="14" FontAttributes="Bold" TextColor="#D97706" />
                </Frame>

                <Label Text="AGENT PIN *" FontSize="10" FontAttributes="Bold" TextColor="#374151" />
                <Frame Padding="15,0" CornerRadius="8" BackgroundColor="White" BorderColor="#D1D5DB" HasShadow="False" HeightRequest="45">
                    <Entry Text="{Binding PinInput}" Placeholder="Enter 4-digit PIN" IsPassword="True" MaxLength="4" Keyboard="Numeric" FontSize="14" FontAttributes="Bold" TextColor="#111827" />
                </Frame>

                <Button Text="MAKE PAYMENT" Clicked="OnProcessPaymentClicked" BackgroundColor="#064E3B" TextColor="White" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" Margin="0,10,0,0" />
                <Button Text="CANCEL" Clicked="OnCloseSheetsClicked" BackgroundColor="Transparent" TextColor="#6B7280" FontAttributes="Bold" HeightRequest="40" />
            </StackLayout>
        </ContentView>

        <!-- ERROR POPUP -->
        <ContentView IsVisible="{Binding ShowErrorSheet}" BackgroundColor="#80000000" VerticalOptions="FillAndExpand">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="White" Padding="25" Spacing="15"  WidthRequest="300">
                <Frame BackgroundColor="#EF4444" HeightRequest="60" WidthRequest="60" CornerRadius="30" HorizontalOptions="Center" HasShadow="False" Padding="0">
                    <Label Text="✕" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>

                <Label Text="PAYMENT FAILED" FontSize="16" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#111827" HorizontalTextAlignment="Center" FontAttributes="Bold" Margin="0,0,0,10" />

                <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0" Text="TRY AGAIN" Clicked="OnCloseSheetsClicked" BackgroundColor="#064E3B" TextColor="White" CornerRadius="8" FontAttributes="Bold" />
                    <Button Grid.Column="1" Text="CANCEL" Clicked="OnCloseSheetsClicked" BackgroundColor="#F3F4F6" TextColor="#6B7280" CornerRadius="8" FontAttributes="Bold" />
                </Grid>
            </StackLayout>
        </ContentView>

        <!-- SUCCESS POPUP -->
        <ContentView IsVisible="{Binding ShowSuccessSheet}" BackgroundColor="#80000000" VerticalOptions="FillAndExpand">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="White" Padding="25" Spacing="15" WidthRequest="300">
                <Frame BackgroundColor="#10B981" HeightRequest="60" WidthRequest="60" CornerRadius="30" HorizontalOptions="Center" HasShadow="False" Padding="0">
                    <Label Text="✓" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>

                <Label Text="PAYMENT SUCCESSFUL" FontSize="16" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center" />
                <Label Text="{Binding SuccessMessage}" FontSize="12" TextColor="#111827" HorizontalTextAlignment="Center" FontAttributes="Bold" Margin="0,0,0,10" />

                <Button Text="PRINT RECEIPT" Clicked="OnPrintReceiptClicked" BackgroundColor="#064E3B" TextColor="White" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" />
                <Button Text="DONE" Clicked="OnCloseSheetsClicked" BackgroundColor="#F3F4F6" TextColor="#6B7280" CornerRadius="8" FontAttributes="Bold" />
            </StackLayout>
        </ContentView>

    </Grid>
</ContentPage>